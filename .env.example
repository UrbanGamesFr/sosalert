# Copier en .env sur le serveur (jamais dans Git). Les valeurs vides sont remplies par scripts/install.sh.

# Nom de domaine servi en HTTPS (le DNS doit pointer vers ce serveur)
DOMAIN=alert.escapegameurbain.com
PUBLIC_URL=https://alert.escapegameurbain.com

# Base de données (généré)
POSTGRES_PASSWORD=

# E-mail d'envoi IONOS (boîte à créer dans IONOS)
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alerte@alert.escapegameurbain.com
SMTP_PASS=
MAIL_FROM=SOSAlert <alerte@alert.escapegameurbain.com>

# Notifications push (générées)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerte@alert.escapegameurbain.com

# Chiffrement des sauvegardes (généré). À COPIER dans un gestionnaire de mots de passe : sans elle, les sauvegardes sont illisibles.
BACKUP_PASSPHRASE=

TERMS_VERSION=2026-10
